<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron/V8 needs JIT-compiled, writable+executable memory under the
         hardened runtime that notarization requires. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- main.js reads JARVIS_DASHBOARD_URL from the spawning process. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- The HUD talks to the loopback dashboard backend over HTTP. -->
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
