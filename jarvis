#!/usr/bin/env python3
"""JARVIS — Autonomous Machine Agent.

    jarvis              CLI (status, log, tidy, stats)
    jarvis daemon       Background scheduler loop
    jarvis setup        Print launchd plist + install instructions
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))


def main() -> None:
    if len(sys.argv) > 1 and sys.argv[1] == "daemon":
        from lib.daemon import run_daemon
        run_daemon()
    elif len(sys.argv) > 1 and sys.argv[1] == "setup":
        from lib.daemon import run_setup
        run_setup()
    else:
        import logging
        logging.basicConfig(level=logging.WARNING, format="%(levelname)s: %(message)s", stream=sys.stderr)
        from lib.cli import main as cli_main
        cli_main()


if __name__ == "__main__":
    main()
